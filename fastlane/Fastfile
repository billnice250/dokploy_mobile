default_platform(:ios)

platform :ios do
  desc "Upload an already signed IPA to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_BASE64"),
      is_key_content_base64: true
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ENV.fetch("IOS_IPA_PATH"),
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  desc "Upload an already signed AAB to a Google Play track using ADC"
  lane :deploy do |options|
    track = options.fetch(:track, "internal")
    allowed_tracks = %w[internal alpha beta production]
    UI.user_error!("Unsupported Play track: #{track}") unless allowed_tracks.include?(track)

    upload_to_play_store(
      aab: ENV.fetch("ANDROID_AAB_PATH"),
      package_name: "it.billnice.apps.dokploy",
      track: track,
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Upload an already signed AAB to Google Play internal testing"
  lane :internal do
    deploy(track: "internal")
  end
end
