default_platform(:ios)

platform :ios do
  desc "Upload an already signed IPA to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_BASE64"),
      is_key_content_base64: true
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ENV.fetch("IOS_IPA_PATH"),
      skip_waiting_for_build_processing: true
    )
  end
end

platform :android do
  desc "Upload an already signed AAB to the Google Play internal track"
  lane :internal do
    upload_to_play_store(
      aab: ENV.fetch("ANDROID_AAB_PATH"),
      json_key_data: ENV.fetch("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"),
      package_name: "it.billnice.apps.dokploy",
      track: "internal",
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end
